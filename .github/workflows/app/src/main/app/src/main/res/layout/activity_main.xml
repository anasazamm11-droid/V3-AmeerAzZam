<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="MIDI DISCONNECTED"
            android:textColor="#FF5252"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#0288D1"
                android:text="TEST"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#D32F2F"
                android:text="RESET"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#1E1E1E"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TRANSPOSE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTransMinus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#333333"
            android:text="−"
            android:textColor="#00E5FF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvTransposeVal"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="#00E5FF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTransPlus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#333333"
            android:text="+"
            android:textColor="#00E5FF"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#1E1E1E"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CENTS STEP"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCentsMinus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#333333"
            android:text="−"
            android:textColor="#FFD54F"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvCentsVal"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="-50"
            android:textColor="#FFD54F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCentsPlus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#333333"
            android:text="+"
            android:textColor="#FFD54F"
            android:textSize="22sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/notesGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4">
    </GridLayout>

</LinearLayout>
